# 复制成 .env 再填：cp .env.example .env
# docker compose 会自动读取同目录的 .env

# ── 必填 ────────────────────────────────────────────────
# 站点域名（只写域名，不带 https://）
SITE_DOMAIN = dshdock.com
# 申请 Let's Encrypt 证书用的邮箱
ACME_EMAIL = you@example.com
# 站点绝对地址，用于 canonical / sitemap / OG / 徽章 Markdown
NEXT_PUBLIC_SITE_URL = https://dshdock.com

# ── 建议填 ──────────────────────────────────────────────
# GitHub token（classic PAT 勾 public_repo 即可，或用 fine-grained token 只读 public 仓库）
# 有它：提交预检和 npm run sync 都稳定；没它：匿名限流 60 次/小时，同步会变慢
GITHUB_TOKEN =

# ── 可选 ────────────────────────────────────────────────
# 同一 IP 每小时最多提交几次
DSHUB_SUBMIT_PER_HOUR = 8
# 是否强制要求仓库声明开源许可证（默认 true，和「收录规范」一致）
DSHUB_REQUIRE_LICENSE = true
